+static int guard_is_set(EFI_SYSTEM_TABLE *SystemTable) {
+    UINT8 val = 0;
+    UINTN size = sizeof(val);
+    UINT32 attrs = 0;
+    return SystemTable->RuntimeServices->GetVariable(guard_name, &guard_guid, &attrs, &size, &val) == EFI_SUCCESS;
+}
+
+static EFI_STATUS guard_set(EFI_SYSTEM_TABLE *SystemTable) {
+    UINT8 val = 1;
+    return SystemTable->RuntimeServices->SetVariable(guard_name, &guard_guid, GUARD_ATTRS, sizeof(val), &val);
+}
+
+static void status_set(EFI_SYSTEM_TABLE *SystemTable, UINT8 code, UINT8 before, UINT8 after, UINT8 mbox) {
+    UINT8 val[4] = {code, before, after, mbox};
+    SystemTable->RuntimeServices->SetVariable(status_name, &guard_guid, GUARD_ATTRS, sizeof(val), val);
+}
+
+static void guard_clear(EFI_SYSTEM_TABLE *SystemTable) {
+    // Only touch NVRAM when the flag exists, so ordinary warm boots cause no writes
+    if (guard_is_set(SystemTable)) {
+        SystemTable->RuntimeServices->SetVariable(guard_name, &guard_guid, GUARD_ATTRS, 0, NULL);
+    }
+}
