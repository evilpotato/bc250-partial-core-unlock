+// Loop guard: a non-volatile flag set just before the warm reset. If we come back with the
+// mask still at FACTORY_MASK and the flag set, the write did not survive the reset, so we
+// give up for this boot instead of resetting again. Cleared once the mask reads 0xFF.
+#define EFI_VARIABLE_NON_VOLATILE 0x1
+#define EFI_VARIABLE_BOOTSERVICE_ACCESS 0x2
+#define EFI_VARIABLE_RUNTIME_ACCESS 0x4
+#define GUARD_ATTRS (EFI_VARIABLE_NON_VOLATILE | EFI_VARIABLE_BOOTSERVICE_ACCESS | EFI_VARIABLE_RUNTIME_ACCESS)
+static EFI_GUID guard_guid = {0x648e8930, 0x3211, 0x4c04, {0x8b, 0x0a, 0xb2, 0xde, 0x73, 0x68, 0x56, 0xcb}};
+static CHAR16 guard_name[] = L"BC250CoreUnlockTry";
+
+// Diagnostics: last outcome of a non-trivial run, readable from Linux as
+// /sys/firmware/efi/efivars/BC250CoreUnlockStatus-<guard guid> (4-byte attr header, then
+// code, mask before, mask after, mailbox status). Not written on plain 0xFF pass-through boots.
+#define ST_RESETTING   0x01  // mask written and read back as 0xFF, warm reset issued
+#define ST_UNLOCKED    0x10  // came back from our reset with mask 0xFF
+#define ST_E_TIMEOUT   0xE1  // SMU mailbox timeout
+#define ST_E_MAILBOX   0xE2  // Q3 0x98 returned non-OK status
+#define ST_E_READBACK  0xE3  // mask did not read 0xFF after the write
+#define ST_E_REVERTED  0xE4  // back at 0xD7 after our reset (loop guard tripped)
+#define ST_E_GUARD     0xE5  // could not set loop-guard variable
+#define ST_E_MASK      0xE6  // unexpected mask value
+static CHAR16 status_name[] = L"BC250CoreUnlockStatus";
+
 // Freestanding helper routines for compiler intrinsic calls
 void *memcpy(void *dest, const void *src, UINTN n) {
